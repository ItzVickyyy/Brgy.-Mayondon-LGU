# Settings for the DEVELOPMENT stack (compose.dev.yml). Copy to .env.dev:
#   Copy-Item .env.dev.example .env.dev
# Everything here is for made-up sample data only. Use passwords that are NOT
# the ones in your real .env. .env.dev is git-ignored.
PROJECT_NAME="Mayondon DEVELOPMENT (sample data)"
SECRET_KEY=dev-only-signing-key-0123456789-abcdefghij-sample
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=DevSample-Admin-2026
FIRST_STAFF=staff@example.com
FIRST_STAFF_PASSWORD=DevSample-Staff-2026
POSTGRES_PASSWORD=dev-sample-db-password
USERS_OPEN_REGISTRATION=False
# Different ports than the real system (5432 and 8000/8001).
POSTGRES_PORT=5433
APP_PORT=8002
APP_BIND=127.0.0.1
# Disposable data: no safety copy before every update, no encryption needed.
PRE_MIGRATION_BACKUP=false
BACKUP_REQUIRE_ENCRYPTION=false
