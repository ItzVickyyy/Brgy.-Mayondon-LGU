# Copy this file to .env and set private values for your own computer.
# Never commit .env or put resident information in source control.
# Generate a signing key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Local development only: uncomment BOTH lines to enable test helper routes and
# relaxed secret warnings. Leave them off for any real deployment.
# FASTAPI_ENV=development
# ENABLE_DEV_ROUTES=true

# REAL DEPLOYMENT: uncomment the next line on the server computer. Without it a
# plain `docker compose up` also loads compose.override.yml, which turns on
# development mode and publishes a database console (Adminer) on port 8080 to
# the whole office network. With it only compose.yml is used.
# COMPOSE_FILE=compose.yml

# How long a sign-in lasts, in minutes (default 480 = 8 hours, one working day).
# ACCESS_TOKEN_EXPIRE_MINUTES=480
PROJECT_NAME="Barangay Mayondon Records and Document Issuance System"

# Replace every sample value before using the system with real records.
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-local-password
# Optional first Staff account (cannot manage user accounts). Set both or neither.
# FIRST_STAFF=staff@example.com
# FIRST_STAFF_PASSWORD=replace-with-a-strong-local-password
USERS_OPEN_REGISTRATION=False

# Issuance rules. How many days back a clerk may date a document, and the longest
# validity (in years) of a Barangay ID. Defaults shown.
# ISSUANCE_BACKDATE_MAX_DAYS=7
# BARANGAY_ID_MAX_VALID_YEARS=5

# Database updates. Every start of the backend brings the database up to date and,
# when it holds data, first saves a safety copy (mayondon-premigrate-*.dump) in the
# backups folder. Defaults shown; change only if you know why.
# MIGRATE_ON_START=true
# PRE_MIGRATION_BACKUP=true

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Offline/LAN deployment defaults: email is intentionally disabled.
# Password recovery and email-based account setup will not work unless the
# client approves and the office provides a reachable local SMTP service.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=False
SMTP_SSL=False
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# Local PostgreSQL used by the development startup guide.
# For Docker Compose, compose.yml supplies the database URL inside the backend
# container using the service name "db".
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://postgres:replace-with-a-strong-database-password@localhost:5432/app

# Database backups (D-35). The app keeps this many of the newest backup files in
# the backups folder and deletes older ones. Default 14.
# BACKUP_KEEP_COPIES=14

# Backup encryption (docs/11 section G). After you have made the key pair with
#   docker compose -f compose.yml exec backend python -m app.backup_cli make-key
# set this to true: every backup (and the safety copy before a database update) is
# then refused unless it can be encrypted. Leave it false until the key exists.
# BACKUP_REQUIRE_ENCRYPTION=true

# Published application port. Office computers use http://<server-LAN-IP>:8000.
APP_PORT=8000

# Keep unset for an offline client deployment unless external monitoring is
# explicitly approved and the network is allowed to reach it.
SENTRY_DSN=

# Mailpit web UI for local email-based tests.
MAILPIT_HOST=http://127.0.0.1:8025

# Development-only CORS origin. The packaged LAN app serves frontend and API
# from the same origin, so office users do not need a separate Vite server.
FRONTEND_HOST=http://localhost:5173
# FRONTEND_HOSTS=http://localhost:5173,http://192.168.1.10:5173

# Use the local PostgreSQL database for offline/LAN deployment.
# Do not replace this with a hosted database URL for offline use.
