# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit `.env`. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Enable development behavior (remove / leave empty on the real client server)
FASTAPI_ENV=development

PROJECT_NAME="Barangay Mayondon LGU System"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Accounts are created by an admin only. Set to True only if the client
# explicitly wants public self-registration.
USERS_OPEN_REGISTRATION=False

# Emails (dev: Mailpit on localhost:1025). Leave SMTP_HOST empty if the
# barangay has no email service; password recovery then stays disabled.
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres: local development (docker compose up -d db)
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Supabase (deployed). Copy the string from Supabase Dashboard -> Connect.
# - Deployed API on Vercel (serverless): Transaction pooler, port 6543
# - Running Alembic migrations: Session pooler (port 5432) or direct connection
# See docs/Complete-Tech-Stacks.md before switching.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Frontend origin allowed by CORS (set to the deployed frontend URL in production)
# FRONTEND_HOST=https://your-frontend.vercel.app
