{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "includes": [
      "**",
      "!**/dist/**/*",
      "!**/node_modules/**/*",
      "!**/src/routeTree.gen.ts",
      "!**/src/client/**/*",
      "!**/src/components/ui/**/*",
      "!**/playwright-report",
      "!**/playwright.config.ts",
      "!**/openapi.json",
      "!**/test-results"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Select"] }
        }
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "error",
        "useSelfClosingElements": "error",
        "noUselessElse": "error"
      }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "includes": [
      "**",
      "!**/src/components/Issuances/IssuanceHistory.tsx",
      "!**/src/components/Issuances/NewIssuance/NewIssuanceDialog.tsx",
      "!**/src/components/Issuances/NewIssuance/PhotoCapture.tsx",
      "!**/src/components/Issuances/NewIssuance/issuanceApi.ts",
      "!**/src/components/Records/ResidentProfileDialog.tsx",
      "!**/src/routes/_layout/issuances.tsx"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
