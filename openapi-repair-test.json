    <title>Brgy. Mayondon LGU</title>
    <script>
      // Apply the saved theme before the first paint so a reload does not flash
      // white first. Keep the key and the default ("dark") in step with
      // ThemeProvider in src/main.tsx.
      (() => {
        var theme = "dark";
        try {
          theme = localStorage.getItem("vite-ui-theme") || "dark";
          if (theme === "system") {
            theme = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
        } catch {}
        document.documentElement.classList.add(theme === "light" ? "light" : "dark");
      })();
    </script>
